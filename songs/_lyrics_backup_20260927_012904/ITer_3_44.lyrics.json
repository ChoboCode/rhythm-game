  "lines": [
    {
      "t": 16.15,
      "end": 18.85,
      "text": "텅 빈 화면 위 깜빡이는 커서 하나",
      "estimated": true
    },
    {
      "t": 18.88,
      "end": 22.0,
      "text": "작은 궁금함이 던진 질문에서 시작해",
      "estimated": true
    },
    {
      "t": 22.03,
      "end": 24.52,
      "text": "납땜 인두 끝에 맺힌 땀방울과",
      "estimated": true
    },
    {
      "t": 24.55,
      "end": 27.46,
      "text": "복잡한 알고리즘 사이 길을 찾아가",
      "estimated": true
    },
    {
      "t": 27.49,
      "end": 29.97,
      "text": "우린 0과 1로 세상을 새로 그려",
      "estimated": true
    },
    {
      "t": 30.0,
      "end": 34.38,
      "text": "무모해 보여도 멈추지 않는 모터",
      "words": [
        {
          "t": 30.0,
          "end": 30.76,
          "text": "무모해"
        },
        {
          "t": 30.76,
          "end": 31.52,
          "text": "보여도"
        },
        {
          "t": 31.52,
          "end": 32.34,
          "text": "멈추지"
        },
        {
          "t": 32.34,
          "end": 32.9,
          "text": "않는"
        },
        {
          "t": 32.9,
          "end": 34.38,
          "text": "모터"
        }
      ]
    },
    {
      "t": 34.76,
      "end": 38.09,
      "text": "부품 하나하나에 진심을 담아",
      "words": [
        {
          "t": 34.76,
          "end": 35.31,
          "text": "부품"
        },
        {
          "t": 35.18,
          "end": 36.34,
          "text": "하나하나에"
        },
        {
          "t": 36.34,
          "end": 37.3,
          "text": "진심을"
        },
        {
          "t": 37.53,
          "end": 38.09,
          "text": "담아"
        }
      ]
    },
    {
      "t": 38.12,
      "end": 41.82,
      "text": "상상은 이제 현실의 문을 두드려",
      "words": [
        {
          "t": 38.12,
          "end": 38.97,
          "text": "상상은"
        },
        {
          "t": 39.42,
          "end": 39.74,
          "text": "이제"
        },
        {
          "t": 39.74,
          "end": 40.64,
          "text": "현실의"
        },
        {
          "t": 40.64,
          "end": 41.12,
          "text": "문을"
        },
        {
          "t": 41.12,
          "end": 41.82,
          "text": "두드려"
        }
      ]
    },
    {
      "t": 43.25,
      "end": 47.16,
      "text": "브레드보드 위로 흐르는 우리들의 꿈",
