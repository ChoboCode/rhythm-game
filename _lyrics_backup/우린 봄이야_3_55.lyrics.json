      "text": "기다린 적 없던 낯선 우연이",
      "resynced": true
    },
    {
      "t": 30.56,
      "end": 33.13,
      "text": "길모퉁이 너머 서성거릴 때",
      "words": [
        {
          "t": 30.56,
          "end": 31.32,
          "text": "길모퉁이"
